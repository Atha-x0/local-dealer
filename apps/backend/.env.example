# Frontend URL to allow CORS (e.g. https://your-vercel-app.vercel.app)
FRONTEND_URL=

# Gemini API Key for LLM features
GEMINI_API_KEY=your_gemini_api_key_here

# Persistence directory for Vector DB (Chroma)
CHROMADB_PERSIST_DIR=./data/chroma

# Optional: Database URL if using PostgreSQL in production
# DATABASE_URL=postgresql://user:password@host:port/dbname
